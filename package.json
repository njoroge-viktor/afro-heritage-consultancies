{
  "name": "afro-heritage-consultancies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "json-server --watch db.json --port 3001 --fks _fk",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "reset-db": "node -e \"require('fs').copyFileSync('db.seed.json','db.json')\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "5.3",
    "bootstrap-icons": "^1.13.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "json-server": "^0.17.4",
    "oxlint": "^1.90.0",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
